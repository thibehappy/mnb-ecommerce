# ─── Shopify Storefront API ────────────────────────────────────
# We use the SAME Shopify store as New-Site-MNB-2 (30kjqi-mp.myshopify.com).
# The Storefront token below is the *public* token from the Headless channel
# (NOT the Admin / shpat_ token). It's safe to expose in the front bundle
# but we keep it server-side so future scope changes don't require a redeploy.
#
# Where to find these :
#   Shopify Admin > Canaux de vente > Headless > Gerer l'acces a l'API
#   Storefront API > Tokens d'acces publics > Copier
#
SHOPIFY_STORE_DOMAIN=30kjqi-mp.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# ─── Product handles ──────────────────────────────────────────
# Set by scripts/generate_shopify_csv.py during the CSV import.
# If you change the handles in Shopify Admin, update these to match.
SHOPIFY_HANDLE_BRACELET=bracelet-personnalise-mnb
SHOPIFY_HANDLE_KIT=kit-diy-mnb

# ─── Admin API (V2 — stock decrement) ─────────────────────────
# Used by the orders/paid webhook to decrement per-bead/per-charm inventory.
# Generate this in : Shopify Admin > Parametres > Apps et canaux > Develop apps
# Create a custom app, scopes : write_inventory, read_inventory, read_products.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shared secret for HMAC-SHA256 verification on the orders/paid webhook.
# When subscribing the webhook in Shopify Admin, paste the same secret.
SHOPIFY_WEBHOOK_SECRET=

# ─── Public site URL (for absolute links in line item properties) ─
NEXT_PUBLIC_SITE_URL=http://localhost:3000
